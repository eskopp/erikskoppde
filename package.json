{
  "name": "chirping-astro",
  "version": "1.2.0",
  "type": "module",
  "description": "A Chirpy-inspired, single-template, multilingual Astro v7 theme with Tailwind v4, daisyUI, MDX, and Pagefind.",
  "license": "GPL-3.0-or-later",
  "private": false,
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run pagefind",
    "preview": "astro preview",
    "serve": "bun run build && bun preview",
    "astro": "astro",
    "pagefind": "pagefind --site dist --output-subdir _pagefind",
    "postbuild": "echo \"Pagefind index generated in dist/_pagefind\"",
    "typecheck": "astro check",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@lichess-org/pgn-viewer": "^2.6.4",
    "@nullpinter/satteri-katex": "^0.1.4",
    "astro": "^7.3.5",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.2.0",
    "mermaid": "^12.0.0",
    "satteri-external-links": "^0.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/source-sans-3": "5.3.0",
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/simple-icons": "^1.2.97",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.4.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.62.1",
    "daisyui": "^5.7.46",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "katex": "^0.18.9",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "satori": "^0.33.5",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "chirpy",
    "tailwindcss",
    "daisyui",
    "mdx",
    "pagefind",
    "i18n",
    "blog"
  ]
}
