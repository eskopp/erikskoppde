---
import { useTranslations } from '../../i18n/utils';
import { SITE, type Locale } from '../../config';

interface Props {
  postSlug: string;
  locale: Locale;
}

const { postSlug, locale } = Astro.props;
const t = useTranslations(locale);
---

<section
  class="comments border-base-300 mt-12 border-t pt-8"
  data-comments
  data-post-slug={postSlug}
  data-api-url={SITE.commentsApiUrl}
  data-reply-label={t('comments.reply')}
  data-submitting-label={t('comments.submitting')}
  data-error-label={t('comments.error')}
  data-rate-limit-label={t('comments.rateLimit')}
>
  <h2 class="text-base-content mb-6 text-xl font-bold tracking-tight">
    {t('comments.title')}
  </h2>

  <noscript>
    <p class="text-base-content/70 text-sm">{t('comments.noscript')}</p>
  </noscript>

  <div data-comments-js>
    <p class="text-base-content/70 text-sm" data-comments-loading>{t('comments.loading')}</p>
    <p class="text-base-content/70 hidden text-sm" data-comments-empty>{t('comments.empty')}</p>
    <div
      role="alert"
      class="alert alert-error alert-soft mb-6 hidden text-sm"
      data-comments-list-error
    >
      {t('comments.error')}
    </div>

    <ul class="mb-8 space-y-4" data-comments-list></ul>

    <div
      class="border-base-300 bg-base-200/50 mb-4 hidden items-center justify-between gap-3 rounded-md border px-4 py-2 text-sm"
      data-comments-reply-banner
    >
      <span
        >{t('comments.replyingTo')} <strong data-comments-reply-name></strong></span
      >
      <button type="button" class="btn btn-ghost btn-xs" data-comments-cancel-reply>
        {t('comments.cancelReply')}
      </button>
    </div>

    <form class="space-y-4" data-comments-form novalidate>
      <input type="hidden" name="ref_id" data-comments-ref-id-input />

      <div>
        <label class="mb-1 block text-sm font-medium" for="comment-name"
          >{t('comments.name')}</label
        >
        <input
          id="comment-name"
          name="name"
          type="text"
          required
          maxlength="80"
          placeholder={t('comments.namePlaceholder')}
          class="input w-full"
        />
      </div>

      <div>
        <label class="mb-1 block text-sm font-medium" for="comment-content"
          >{t('comments.content')}</label
        >
        <textarea
          id="comment-content"
          name="content"
          required
          maxlength="3000"
          rows="4"
          placeholder={t('comments.contentPlaceholder')}
          class="textarea w-full"></textarea>
      </div>

      <div class="sr-only" aria-hidden="true">
        <label for="comment-website">Website</label>
        <input id="comment-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div
        role="alert"
        class="alert alert-error alert-soft hidden text-sm"
        data-comments-form-error
      >
      </div>

      <button type="submit" class="btn btn-primary btn-sm" data-comments-submit>
        {t('comments.submit')}
      </button>
    </form>
  </div>
</section>

<script>
  interface Comment {
    id: number;
    ref_id: number | null;
    post_slug: string;
    name: string;
    content: string;
    created_at: string;
  }

  function escapeAndLinkify(text: string): string {
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');
  }

  function setupComments(root: HTMLElement) {
    const postSlug = root.dataset.postSlug;
    const apiUrl = root.dataset.apiUrl;
    if (!postSlug || !apiUrl) return;

    const replyLabel = root.dataset.replyLabel ?? 'Reply';
    const submittingLabel = root.dataset.submittingLabel ?? '';
    const errorLabel = root.dataset.errorLabel ?? '';
    const rateLimitLabel = root.dataset.rateLimitLabel ?? '';
    const locale = document.documentElement.lang || 'de';

    const listEl = root.querySelector<HTMLUListElement>('[data-comments-list]');
    const loadingEl = root.querySelector<HTMLElement>('[data-comments-loading]');
    const emptyEl = root.querySelector<HTMLElement>('[data-comments-empty]');
    const listErrorEl = root.querySelector<HTMLElement>('[data-comments-list-error]');
    const form = root.querySelector<HTMLFormElement>('[data-comments-form]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-comments-submit]');
    const formErrorEl = root.querySelector<HTMLElement>('[data-comments-form-error]');
    const refIdInput = root.querySelector<HTMLInputElement>('[data-comments-ref-id-input]');
    const replyBanner = root.querySelector<HTMLElement>('[data-comments-reply-banner]');
    const replyNameEl = root.querySelector<HTMLElement>('[data-comments-reply-name]');
    const cancelReplyBtn = root.querySelector<HTMLButtonElement>('[data-comments-cancel-reply]');

    if (!listEl || !form || !submitBtn) return;
    const submitLabel = submitBtn.textContent ?? '';

    function buildCommentItem(comment: Comment): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'border-base-300 bg-base-100 rounded-md border p-4';
      li.dataset.commentId = String(comment.id);

      const header = document.createElement('div');
      header.className = 'mb-1 flex items-center justify-between gap-2';

      const name = document.createElement('span');
      name.className = 'text-base-content text-sm font-semibold';
      name.textContent = comment.name;

      const date = document.createElement('time');
      date.className = 'text-base-content/60 text-xs';
      date.dateTime = comment.created_at;
      date.textContent = new Date(comment.created_at).toLocaleDateString(locale, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });

      header.append(name, date);

      const body = document.createElement('p');
      body.className = 'text-base-content/85 text-sm whitespace-pre-wrap';
      body.innerHTML = escapeAndLinkify(comment.content);

      const replyBtn = document.createElement('button');
      replyBtn.type = 'button';
      replyBtn.className = 'btn btn-ghost btn-xs mt-2';
      replyBtn.dataset.commentsReplyTrigger = String(comment.id);
      replyBtn.dataset.commentsReplyName = comment.name;
      replyBtn.textContent = replyLabel;

      li.append(header, body, replyBtn);
      return li;
    }

    function renderList(comments: Comment[]) {
      listEl!.innerHTML = '';
      const byRef = new Map<number | null, Comment[]>();
      for (const c of comments) {
        const key = c.ref_id;
        if (!byRef.has(key)) byRef.set(key, []);
        byRef.get(key)!.push(c);
      }

      function appendChildren(parentId: number | null, container: HTMLElement, depth: number) {
        const children = byRef.get(parentId) ?? [];
        for (const child of children) {
          const item = buildCommentItem(child);
          if (depth > 0) item.classList.add('ml-6');
          container.appendChild(item);
          appendChildren(child.id, container, depth + 1);
        }
      }

      appendChildren(null, listEl!, 0);
      emptyEl?.classList.toggle('hidden', comments.length !== 0);
    }

    function startReply(id: string, name: string) {
      if (!refIdInput || !replyBanner || !replyNameEl) return;
      refIdInput.value = id;
      replyNameEl.textContent = name;
      replyBanner.classList.remove('hidden');
      replyBanner.classList.add('flex');
      form?.querySelector<HTMLTextAreaElement>('#comment-content')?.focus();
    }

    function cancelReply() {
      if (!refIdInput || !replyBanner) return;
      refIdInput.value = '';
      replyBanner.classList.add('hidden');
      replyBanner.classList.remove('flex');
    }

    cancelReplyBtn?.addEventListener('click', cancelReply);

    listEl.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest<HTMLButtonElement>(
        '[data-comments-reply-trigger]',
      );
      if (!target) return;
      startReply(
        target.dataset.commentsReplyTrigger ?? '',
        target.dataset.commentsReplyName ?? '',
      );
    });

    async function loadComments() {
      loadingEl?.classList.remove('hidden');
      listErrorEl?.classList.add('hidden');
      try {
        const res = await fetch(`${apiUrl}/comments?post_slug=${encodeURIComponent(postSlug!)}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const comments: Comment[] = await res.json();
        renderList(comments);
      } catch {
        listErrorEl?.classList.remove('hidden');
      } finally {
        loadingEl?.classList.add('hidden');
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formErrorEl?.classList.add('hidden');

      const formData = new FormData(form);
      const name = String(formData.get('name') ?? '').trim();
      const content = String(formData.get('content') ?? '').trim();
      const website = String(formData.get('website') ?? '');
      const refIdRaw = String(formData.get('ref_id') ?? '');

      if (!name || !content) return;

      submitBtn.disabled = true;
      submitBtn.textContent = submittingLabel;

      try {
        const res = await fetch(`${apiUrl}/comments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            post_slug: postSlug,
            name,
            content,
            website,
            ref_id: refIdRaw ? Number(refIdRaw) : null,
          }),
        });

        if (res.status === 429) {
          if (formErrorEl) {
            formErrorEl.textContent = rateLimitLabel;
            formErrorEl.classList.remove('hidden');
          }
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        form.reset();
        cancelReply();
        await loadComments();
      } catch {
        if (formErrorEl) {
          formErrorEl.textContent = errorLabel;
          formErrorEl.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });

    void loadComments();
  }

  function init() {
    document.querySelectorAll<HTMLElement>('[data-comments]').forEach(setupComments);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
