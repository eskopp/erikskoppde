---
/**
 * Lichess PGN Viewer client island.
 * Renders a chess game from PGN notation into an interactive, replayable board.
 */
import '../../styles/vendor/lichess-pgn-viewer.css';

interface Props {
  pgn: string;
  /** Optional stable id if multiple viewers are on the same page. */
  id?: string;
  /**
   * Standard PGN header tags (Event, Site, Date, White, Black, Result, …).
   * Without these a PGN is technically incomplete — the viewer itself gets
   * by without them, but the no-JS fallback text should still be a proper,
   * self-contained PGN that any other chess program can read correctly.
   */
  headers?: Record<string, string>;
}

const { pgn, id = 'pgn-viewer', headers } = Astro.props;

const headerLines = Object.entries(headers ?? {}).map(([key, value]) => `[${key} "${value}"]`);
// The div's data-pgn feeds the interactive viewer too, so it also picks up
// player names, date, etc. for its metadata (aria labels, result display).
const fullPgn = headerLines.length ? `${headerLines.join('\n')}\n\n${pgn}` : pgn;

// Word-wrap the movetext at a readable width (same convention chess
// software uses when exporting PGN files) for the no-JS fallback below, so
// it's still usable pasted into any PGN reader instead of one giant line.
// Header tags are already one per line and are left as-is.
function wrapPgn(text: string, width = 80): string {
  const words = text.split(/\s+/);
  const lines: string[] = [];
  let line = '';
  for (const word of words) {
    if (line && line.length + word.length + 1 > width) {
      lines.push(line);
      line = word;
    } else {
      line = line ? `${line} ${word}` : word;
    }
  }
  if (line) lines.push(line);
  return lines.join('\n');
}

const wrappedPgn = [...headerLines, ...(headerLines.length ? [''] : []), ...wrapPgn(pgn).split('\n')].join(
  '\n',
);
---

<div id={id} class="chirpy-pgn-viewer" data-pgn={fullPgn}>
  <noscript>
    <div class="chirpy-pgn-noscript">
      <p>
        Für das interaktive Brett wird JavaScript benötigt. Hier die Partie im PGN-Format zum
        Nachspielen in einem beliebigen Schachprogramm:
      </p>
      <pre>{wrappedPgn}</pre>
    </div>
  </noscript>
</div>

<script>
  import LichessPgnViewer from '@lichess-org/pgn-viewer';

  // LichessPgnViewer replaces the target element with a new DOM node on
  // mount, so a `data-rendered` flag on the element itself would be lost
  // before a second listener (below) can observe it. Guard at module scope
  // instead, since `astro:page-load` fires once even on a plain page load.
  let rendered = false;

  function renderViewers() {
    if (rendered) return;
    rendered = true;
    document.querySelectorAll<HTMLElement>('.chirpy-pgn-viewer').forEach((el) => {
      const pgn = el.dataset.pgn ?? '';
      LichessPgnViewer(el, { pgn });
    });
  }

  document.addEventListener('astro:page-load', renderViewers);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderViewers);
  } else {
    renderViewers();
  }
</script>

<style>
  .chirpy-pgn-noscript pre {
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 0.875em;
  }
</style>

<style is:global>
  /* lichess-pgn-viewer.css ships no board theme — light squares are
     --board-color as-is, dark squares are the same color with a 20% black
     overlay baked into the CSS. Unset, the board defaults to a near-black
     mush. This is the classic lichess "brown" theme's light-square hex. */
  .lpv {
    --board-color: #f0d9b5;
  }

  /* Squares are one repeating background image, not separate elements, so
     a wood-grain texture can only be layered uniformly on top rather than
     varied per square. Self-hosted CSS approximation of lichess's wood
     board themes (no image asset, no external request) — streaks at a
     slight angle plus a soft light source, blended into --board-color. */
  .lpv cg-board::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(
        91deg,
        rgba(60, 30, 5, 0.07) 0px,
        rgba(60, 30, 5, 0.07) 1px,
        transparent 2px,
        transparent 5px
      ),
      repeating-linear-gradient(
        88deg,
        rgba(255, 235, 200, 0.08) 0px,
        rgba(255, 235, 200, 0.08) 1px,
        transparent 3px,
        transparent 10px
      ),
      radial-gradient(ellipse at 28% 18%, rgba(255, 255, 255, 0.12), transparent 55%);
    mix-blend-mode: multiply;
  }
</style>
