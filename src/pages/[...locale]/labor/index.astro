---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import { SITE } from '~/config';
import { useTranslations } from '~/i18n/utils';
import { getPosts } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const posts = await getPosts(locale, { section: 'labor' });
---

<BaseLayout
  title={t('labor.title')}
  description={t('labor.description')}
  pathWithoutLocale="/labor/"
  crumbs={[{ label: t('labor.title') }]}
>
  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight">{t('labor.title')}</h1>
    <p class="text-base-content/70 mt-1 text-sm">{t('labor.description')}</p>
  </header>
  {
    posts.length === 0 ? (
      <p class="text-base-content/70">{t('labor.empty')}</p>
    ) : (
      <PostList posts={posts} locale={locale} />
    )
  }
</BaseLayout>
